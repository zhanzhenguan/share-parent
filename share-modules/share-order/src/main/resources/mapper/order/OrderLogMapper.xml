<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.share.order.mapper.OrderLogMapper">

    <resultMap type="com.share.order.domain.OrderLog" id="OrderLogResult">
        <id     property="id"            column="id"             />
        <result property="orderId"       column="order_id"       />
        <result property="operateUser"   column="operate_user"   />
        <result property="processStatus" column="process_status" />
        <result property="note"          column="note"           />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
        <result property="delFlag"       column="del_flag"       />
    </resultMap>

    <sql id="selectOrderLogVo">
        select id, order_id, operate_user, process_status, note, create_by, create_time,
               update_by, update_time, remark, del_flag
        from order_log
    </sql>

    <select id="selectOrderLogList" parameterType="com.share.order.domain.OrderLog" resultMap="OrderLogResult">
        <include refid="selectOrderLogVo"/>
        <where>
            del_flag = '0'
            <if test="orderId != null"> and order_id = #{orderId}</if>
            <if test="operateUser != null and operateUser != ''"> and operate_user like concat('%', #{operateUser}, '%')</if>
            <if test="processStatus != null"> and process_status = #{processStatus}</if>
        </where>
        order by create_time desc
    </select>
</mapper>
