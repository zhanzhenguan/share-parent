<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.share.order.mapper.OrderBillMapper">

    <resultMap type="com.share.order.domain.OrderBill" id="OrderBillResult">
        <id     property="id"          column="id"           />
        <result property="orderId"     column="order_id"     />
        <result property="billItem"    column="bill_item"    />
        <result property="billAmount"  column="bill_amount"  />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
        <result property="delFlag"     column="del_flag"     />
    </resultMap>

    <sql id="selectOrderBillVo">
        select id, order_id, bill_item, bill_amount, create_by, create_time,
               update_by, update_time, remark, del_flag
        from order_bill
    </sql>

    <select id="selectOrderBillList" parameterType="com.share.order.domain.OrderBill" resultMap="OrderBillResult">
        <include refid="selectOrderBillVo"/>
        <where>
            del_flag = '0'
            <if test="orderId != null"> and order_id = #{orderId}</if>
            <if test="billItem != null and billItem != ''"> and bill_item like concat('%', #{billItem}, '%')</if>
        </where>
        order by id desc
    </select>
</mapper>
