<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.share.user.mapper.UserLoginLogMapper">

    <resultMap type="com.share.user.domain.UserLoginLog" id="UserLoginLogResult">
        <id     property="id"         column="id"          />
        <result property="userId"     column="user_id"     />
        <result property="ipaddr"     column="ipaddr"      />
        <result property="status"     column="status"      />
        <result property="msg"        column="msg"         />
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by"   />
        <result property="updateTime" column="update_time" />
        <result property="remark"     column="remark"      />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectUserLoginLogVo">
        select id, user_id, ipaddr, status, msg, create_by, create_time,
               update_by, update_time, remark, del_flag
        from user_login_log
    </sql>

    <select id="selectUserLoginLogList" parameterType="com.share.user.domain.UserLoginLog" resultMap="UserLoginLogResult">
        <include refid="selectUserLoginLogVo"/>
        <where>
            del_flag = '0'
            <if test="userId != null"> and user_id = #{userId}</if>
            <if test="ipaddr != null and ipaddr != ''"> and ipaddr like concat('%', #{ipaddr}, '%')</if>
            <if test="status != null"> and status = #{status}</if>
        </where>
        order by create_time desc
    </select>
</mapper>
